# Copy to .env or set these as machine environment variables on each server.
# Keep credentials out of this file; use trusted DSNs or secure server secrets.

FORECAST_OUTPUT_DIR=forecast_outputs
FORECAST_WEATHER_CACHE_DIR=weather_cache

# Set one of these for the interval parquet export root used by the solar forecast.
# If blank, config.yaml will try D:/PY_LRS and then C:/PY_LRS when those folders exist.
FORECAST_DATA_ROOT=
FORECAST_SOLAR_PARQUET_ROOT=

# Server-specific ODBC DSN names.
FORECAST_SQL_DSN=Informatica LRS
FORECAST_OUTPUT_SQL_DSN=Forecast_DB
FORECAST_FIVE_MIN_DSN=PowerSupply
FORECAST_LOCAL_WEATHER_DSN=PowerSupply

# Solar database connection used by forecasting/solar/solar_forecaster.py.
FORECAST_SOLAR_DRIVER=ODBC Driver 17 for SQL Server
FORECAST_SOLAR_DEST_SERVER=re-lrs-db-1
FORECAST_SOLAR_DEST_DB=Forecast
FORECAST_SOLAR_PRODUCTION_SOURCE=rec-parquet
